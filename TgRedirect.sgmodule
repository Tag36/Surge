#!name=Telegram 链接重定向
#!desc=将tg链接跳转到第三方客户端

[Script]
TgRedirect = type=http-request,pattern=^https?://(t[.]me|telegram[.]me)(/|[?]|$),script-path=https://raw.githubusercontent.com/Tag36/Surge/refs/heads/main/Telegram.js,argument=client=Telegram,timeout=3
[MITM]
hostname = %APPEND% t.me, telegram.me
